# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Airflow Core Settings
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3-python3.11
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Metadata Database (Airflow Internal DB)
POSTGRES_METADATA_USER=airflow
POSTGRES_METADATA_PASSWORD=airflow
POSTGRES_METADATA_DB=airflow
POSTGRES_METADATA_PORT=5432

# Analytical Data Warehouse (DWH / Datamart)
POSTGRES_DWH_USER=datamart_user
POSTGRES_DWH_PASSWORD=datamart_secure_pass
POSTGRES_DWH_DB=datamart_dwh
POSTGRES_DWH_PORT=5433

# Airflow Auto-configured Connections & Variables
AIRFLOW_CONN_POSTGRES_DWH=postgresql://datamart_user:datamart_secure_pass@postgres-dwh:5432/datamart_dwh
AIRFLOW_VAR_RAW_DATA_PATH=/opt/airflow/data/raw
AIRFLOW_VAR_DEFAULT_RETRY_COUNT=2
