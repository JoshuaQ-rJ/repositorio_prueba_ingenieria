# ==============================================================================
# Environment Configuration Template (.env.example)
# Copia este archivo como .env y ajusta los valores de credenciales locales.
# NUNCA guardes contraseñas reales ni cadenas de conexión en este archivo.
# ==============================================================================

# Versión e imagen base de Apache Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3-python3.11

# UID para permisos de volumen en sistemas Linux / Docker
AIRFLOW_UID=50000

# Credenciales del usuario administrador para acceder a la UI de Airflow (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me_admin_pass

# Base de datos de metadatos interna de Apache Airflow (PostgreSQL dedicado)
POSTGRES_METADATA_USER=airflow
POSTGRES_METADATA_PASSWORD=change_me_metadata_pass
POSTGRES_METADATA_DB=airflow
POSTGRES_METADATA_PORT=5432

# Repositorio analítico destino de DataMart (Data Warehouse PostgreSQL dedicado)
POSTGRES_DWH_USER=datamart_user
POSTGRES_DWH_PASSWORD=change_me_dwh_secure_pass
POSTGRES_DWH_DB=datamart_dwh
POSTGRES_DWH_PORT=5433

# URL interna de la API REST del catálogo de productos
CATALOG_API_URL=http://catalog-api:8000

# Conexiones y Variables inicializadas automáticamente por Airflow al arrancar
AIRFLOW_CONN_POSTGRES_DWH=postgresql://datamart_user:change_me_dwh_secure_pass@postgres-dwh:5432/datamart_dwh
AIRFLOW_VAR_RAW_DATA_PATH=/opt/airflow/data/raw
AIRFLOW_VAR_DEFAULT_RETRY_COUNT=2
